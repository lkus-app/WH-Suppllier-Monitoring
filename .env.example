# ============================================================================
# DOCK & DELIVERY SLOT MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION
# ============================================================================

# 1. DATABASE CONNECTION (PostgreSQL with Prisma ORM)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dock_slot_db?schema=public"

# 2. AUTHENTICATION & SECURITY (NextAuth / JWT Session Secrets)
# Generate a strong 32+ character random secret using: openssl rand -base64 32
NEXTAUTH_SECRET="super-secret-random-jwt-key-change-this-in-production-min-32-chars"
AUTH_SECRET="super-secret-random-jwt-key-change-this-in-production-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# 3. AI STUDIO / GEMINI INTEGRATION (Optional AI Assistant Features)
# Required for Gemini AI API calls (slot recommendations & anomaly analysis)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# 4. APPLICATION HOSTING & URL
# Used for QR code gate pass URLs, self-referential links, and CORS headers
APP_URL="http://localhost:3000"

