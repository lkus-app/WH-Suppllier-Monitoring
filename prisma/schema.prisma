// This is your Prisma schema file for Dock & Delivery Slot Management System
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --------------------------------------------------------
// ENUMS
// --------------------------------------------------------

enum UserRole {
  ADMIN
  PURCHASING
  PPIC
  SUPPLIER
  WAREHOUSE
}

enum DockType {
  GENERAL          // Standard docks for CDE, CDD, Fuso, Wingbox
  LIQUID_ISOTANK   // Dedicated unloading bay with piping & pumps for Isotank / Tangki
  CONTAINER        // High bay dock with container leveller for 20ft/40ft containers
}

enum PurchaseOrderStatus {
  DRAFT            // Created by Purchasing, awaiting PPIC review
  PPIC_APPROVED    // Approved by PPIC with ETA window, ready for Supplier booking
  SCHEDULED        // Supplier has booked a dock delivery slot
  IN_PROGRESS      // Vehicle arrived at gate / currently unloading
  COMPLETED        // Unloaded & Gate Out
  CANCELLED        // Cancelled PO
}

enum BookingStatus {
  BOOKED           // Slot confirmed by supplier
  ARRIVED          // Gate-In / Driver registered at Security
  UNLOADING        // Actively discharging cargo at dock
  DONE             // Unloading finished & Gate-Out completed
  CANCELLED        // Slot cancelled or re-scheduled
}

// --------------------------------------------------------
// MODELS
// --------------------------------------------------------

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String
  passwordHash  String?
  role          UserRole  @default(SUPPLIER)
  supplierName  String?   // Populated if role is SUPPLIER
  phoneNumber   String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  createdPOs    PurchaseOrder[] @relation("POCreator")
  createdSlots  Booking[]       @relation("BookingCreator")

  @@map("users")
}

model Vehicle {
  id                     String    @id @default(uuid())
  vehicleName            String    @unique // e.g. "Engkel (CDE)", "Double Engkel (CDD)", "Fuso", "Wingbox 10 Ton", "Wingbox 20 Ton", "Isotank", "Kontainer 20/40 ft"
  code                   String    @unique // e.g. "CDE", "CDD", "FUSO", "WB10", "WB20", "ISOTANK", "CONT"
  defaultDurationMinutes Int       // Default unloading duration in minutes
  allowedDockTypes       DockType[] // Which dock types can accommodate this vehicle
  description            String?
  isActive               Boolean   @default(true)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  bookings               Booking[]

  @@map("vehicles")
}

model Dock {
  id               String    @id @default(uuid())
  dockName         String    @unique // e.g. "Dock 01", "Dock 02", "Dock 03 (Tangki)", "Dock 04 (Kontainer)"
  dockType         DockType  @default(GENERAL)
  maxTonnage       Decimal?  @db.Decimal(10, 2)
  notes            String?
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  bookings         Booking[]

  @@map("docks")
}

model PurchaseOrder {
  id                 String              @id @default(uuid())
  poNumber           String              @unique // e.g. "PO-2026-0801"
  supplierName       String
  supplierEmail      String?
  itemDescription    String
  qty                Decimal             @db.Decimal(12, 2)
  unit               String              // e.g. "KG", "PALLET", "DRUM", "BAG", "LITER"
  ppicEtaDateStart   DateTime?           // Window start set by PPIC
  ppicEtaDateEnd     DateTime?           // Window end set by PPIC
  ppicNotes          String?
  status             PurchaseOrderStatus @default(DRAFT)
  
  createdById        String?
  createdBy          User?               @relation("POCreator", fields: [createdById], references: [id])

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  booking            Booking?

  @@index([supplierName])
  @@index([status])
  @@map("purchase_orders")
}

model Booking {
  id                 String        @id @default(uuid())
  bookingCode        String        @unique // e.g. "SLOT-20260830-D1-001"
  
  // Relations
  poId               String        @unique
  purchaseOrder      PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Restrict)
  
  dockId             String
  dock               Dock          @relation(fields: [dockId], references: [id], onDelete: Restrict)
  
  vehicleId          String
  vehicle            Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  // Driver & Armada Info
  driverName         String
  driverPhone        String?
  licensePlate       String        // e.g. "B 9842 UXX"

  // Time Window
  startTime          DateTime      // Booking arrival start (e.g. 08:00)
  endTime            DateTime      // Estimated completion time = startTime + duration
  durationMinutes    Int           // Locked duration based on vehicle type or admin override

  // Actual Warehouse Execution Timestamps
  actualGateIn       DateTime?     // Security check-in
  actualStartUnload  DateTime?     // Unloading started at dock
  actualFinishUnload DateTime?     // Unloading done
  actualGateOut      DateTime?     // Truck exit factory

  warehouseNotes      String?       // Catatan hasil inspeksi / kendala bongkar gudang
  unloadingStaffName  String?       // Nama operator forklift / staff gudang penanggung jawab

  status             BookingStatus @default(BOOKED)
  cancellationReason String?
  remarks            String?

  createdById        String?
  createdBy          User?         @relation("BookingCreator", fields: [createdById], references: [id])

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  // Indexing for rapid overlap query:
  // (startTime < newEndTime) AND (endTime > newStartTime)
  @@index([dockId, startTime, endTime])
  @@index([status])
  @@index([startTime])
  @@map("bookings")
}

model SystemSetting {
  id                  String   @id @default("GLOBAL_CONFIG")
  factoryOpenTime     String   @default("08:00") // Format HH:mm
  maxArrivalBookingTime String @default("19:00") // Format HH:mm (Batas akhir slot kedatangan)
  factoryCloseTime    String   @default("23:00") // Format HH:mm (Pabrik Tutup)
  slotIntervalMinutes Int      @default(30)      // Interval pecahan slot (30 atau 60 menit)
  updatedAt           DateTime @updatedAt

  @@map("system_settings")
}

model OperationalHoliday {
  id          String   @id @default(uuid())
  date        DateTime @unique
  description String

  @@map("operational_holidays")
}

// Backward-compatible alias model
model OperationalSetting {
  id                   String   @id @default("default")
  factoryOpenTime      String   @default("08:00") // 08:00
  maxArrivalBookingTime String  @default("19:00") // 19:00
  factoryCloseTime     String   @default("23:00") // 23:00
  slotIntervalMinutes  Int      @default(30)      // Grid interval: 30 mins
  updatedAt            DateTime @updatedAt

  @@map("operational_settings")
}
